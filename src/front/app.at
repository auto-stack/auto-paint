// app.at — 031-paint 像素画板根组件（Plan 553 → PAINT-001）。
//
// 形态：单组件内聚（025/028 形态——store 子组件 vue TS 生成损坏先例 013/038，
// 全部状态进 App model）。
//
// 颜色表示（PAINT-001 T-02 修订）：**像素真值 = 受验证 hex 色值**（"#rrggbb"，
// 词汇表 = 16 色板 + 白色橡皮色，闭合集合）；Tailwind 类串只是展示派生
// （chip_of 映射，字面类串留在源码内 → Tailwind JIT 扫描命中；运行时拼接的
// 任意值类不可见，T3 实测）。旧 v1（256 段类串 join "|"）只读迁移：
// ` bg-[#rrggbb] ` → hex，非词汇表色/非 256 项拒绝（坏数据不覆盖当前画布）。
// 工程格式 paint.project.v2 = "PAINT-V2|16|16|<hex×256>"（版本/尺寸/色值），
// 写入后回读比对一致才置 saved（写入结果不用无条件 saved 标记）。
//
// 变更纪律（T6 VM 实测保留）：**运行时 str 列表禁止下标写**（`.px[i] = v`
// 静默不生效）。一律本地构建新列表 → 整体赋值 `.px = np`。单格改动走
// `.SetPx`（256 拷贝），泛洪 BFS 只算 seen 标记再单趟重建。
//
// 快照/存储失败语义（PAINT-001）：Undo/Redo/Load 的快照应用逐项校验，
// 非法整体拒绝（不部分应用，当前画布不动）。历史 VM 债 P553-D1（全同串
// 列表 Redo/Load 塌缩）在工具链 v0.0.20-117-g873fa23 未复现（T-01 实测
// 31/0/0），V-01 以全白/全黑反例矩阵继续覆盖。

use stylekit.styles: caption_text

style tool_btn = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
style wrap_row = "items-center gap-2 flex-wrap"

widget App {
    msg {
        Init, SetTool(str), SetCur(str), Paint(int), Fill(int), SetPx(int, str),
        PushUndo, Undo, Redo, ApplySnap(str), Clear, New, Save, Load
    }

    model {
        // ---- 颜色词汇表（hex 真值；白色 = 橡皮色）----
        var white str = "#ffffff"
        var palette = [
            "#111827", "#ef4444", "#f97316", "#f59e0b",
            "#84cc16", "#22c55e", "#14b8a6", "#3b82f6",
            "#6366f1", "#a855f7", "#ec4899", "#92400e",
            "#57534e", "#a8a29e", "#e7e5e4", "#ffffff"
        ]

        // ---- 画布 ----
        var canvas_cols int = 16   // 表式 cols → 生成内联 grid-template-columns
                                   // （字面量 int 走 grid-cols-N 类，N>12 超
                                   // Tailwind 刻度不生成——ui_gen/vue.rs 10289；
                                   // 038 动态列同型）
        var px = []                 // 256 × hex 真值（初始全白）
        var cells = []              // {i, chip} 行对象（handler 重建）

        // ---- 工具与当前色 ----
        var tool str = "pencil"     // pencil | eraser | fill | picker
        var cur str = "#111827"
        var cur_chip str = " bg-[#111827] "
        var swatches = []           // {c, chip, sel} 行对象（handler 重建）
        var pencil_class str = ""
        var eraser_class str = ""
        var fill_class str = ""
        var picker_class str = ""

        // ---- 历史 ----
        var undo_stack = []         // hex 快照串列表，上限 20
        var redo_stack = []
        var saved str = "1"         // "0" = 有未保存改动（标题行 ● 提示）

        // ---- 状态条 ----
        var status str = ""
    }

    view {
        col {
            // mx-auto: Fill+max-w 子项不参与父级 items-center(iced 端),
            // auto 边距负责在画廊视口内水平居中
            style: "w-full max-w-2xl bg-card border rounded-2xl shadow-2xl p-4 gap-3 mx-auto"

            // ---- 标题 + 工具行 ----
            row {
                style: wrap_row
                text "Paint" { style: "text-base font-semibold text-foreground mr-2" }
                if .saved == "0" {
                    text "●" { style: "text-xs text-primary" }
                }
                button "✏ Pencil" { onclick: .SetTool("pencil"), style: .pencil_class }
                button "◻ Eraser" { onclick: .SetTool("eraser"), style: .eraser_class }
                button "🪣 Fill" { onclick: .SetTool("fill"), style: .fill_class }
                button "💧 Picker" { onclick: .SetTool("picker"), style: .picker_class }
            }

            // ---- 画布（16×16；容器 muted 底透 gap 成网格线）----
            col {
                style: "p-1 bg-muted/50 border rounded-lg w-fit"
                grid {
                    cols: .canvas_cols
                    gap: 1
                    for c in .cells {
                        col {
                            onclick: .Paint(c.i)
                            style: "w-5 h-5${c.chip}cursor-pointer"
                        }
                    }
                }
            }

            // ---- 调色板（当前色块 + 8×2 色板）----
            row {
                style: "items-center gap-3"
                col {
                    style: "flex flex-col items-center gap-1"
                    col {
                        style: "w-8 h-8 rounded-lg border${.cur_chip}"
                    }
                    text "Current" { style: caption_text }
                }
                grid {
                    cols: 8
                    gap: 1
                    for s in .swatches {
                        col {
                            onclick: .SetCur(s.c)
                            style: "w-6 h-6 rounded${s.chip}${s.sel}cursor-pointer"
                        }
                    }
                }
            }

            // ---- 操作行 + 状态条 ----
            row {
                style: wrap_row
                button "Undo" { onclick: .Undo, style: tool_btn }
                button "Redo" { onclick: .Redo, style: tool_btn }
                button "Clear" { onclick: .Clear, style: tool_btn }
                button "New" { onclick: .New, style: tool_btn }
                button "Save" { onclick: .Save, style: "px-3 py-1.5 text-sm rounded-lg bg-primary text-primary-foreground" }
                button "Load" { onclick: .Load, style: "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary" }
                text .status { style: "ml-auto text-xs text-muted-foreground" }
            }
        }
    }

    on {
        .Init -> {
            var ip = []
            var k int = 0
            while k < 256 {
                ip.push(.white)
                k = k + 1
            }
            .px = ip
            .undo_stack = []
            .redo_stack = []
            .saved = "1"
            .status = ""
            .tool = "pencil"
            .cur = "#111827"
            .cur_chip = " bg-[#111827] "
            .ToolClasses()
            .Swatches()
            .RebuildCells()
        }

        // ---- 工具/当前色（选中态经 class 串状态，038 难度按钮同型）----
        .SetTool(t) -> {
            .tool = t
            .ToolClasses()
            .status = ""
        }

        .SetCur(c) -> {
            .cur = c
            .cur_chip = chip_of(c)
            .Swatches()
            .status = ""
        }

        .ToolClasses -> {
            if .tool == "pencil" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
            }
            if .tool == "eraser" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
            }
            if .tool == "fill" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
            }
            if .tool == "picker" {
                .pencil_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .eraser_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .fill_class = "px-3 py-1.5 text-sm rounded-lg bg-secondary text-secondary-foreground hover:bg-secondary/80"
                .picker_class = "px-3 py-1.5 text-sm rounded-lg bg-primary/15 text-primary"
            }
        }

        .Swatches -> {
            .swatches = []
            var k int = 0
            while k < .palette.len() {
                var sel str = " border border-transparent "
                if .palette[k] == .cur {
                    sel = " border border-primary "
                }
                .swatches.push({ c: .palette[k], chip: chip_of(.palette[k]), sel: sel })
                k = k + 1
            }
        }

        .RebuildCells -> {
            .cells = []
            var k int = 0
            while k < 256 {
                .cells.push({ i: k, chip: chip_of(.px[k]) })
                k = k + 1
            }
        }

        // ---- 单格替换（本地构建 → 整体赋值；下标写静默失效，见文件头）----
        .SetPx(i, v) -> {
            var np = []
            var k int = 0
            while k < 256 {
                if k == i {
                    np.push(v)
                } else {
                    np.push(.px[k])
                }
                k = k + 1
            }
            .px = np
        }

        // ---- 落笔分派 ----
        .Paint(i) -> {
            if .tool == "pencil" {
                if .px[i] != .cur {
                    .PushUndo()
                    .SetPx(i, .cur)
                    .RebuildCells()
                }
            }
            if .tool == "eraser" {
                if .px[i] != .white {
                    .PushUndo()
                    .SetPx(i, .white)
                    .RebuildCells()
                }
            }
            if .tool == "fill" {
                .Fill(i)
            }
            if .tool == "picker" {
                .cur = .px[i]
                .cur_chip = chip_of(.px[i])
                .Swatches()
            }
        }

        // ---- 历史栈 ----
        .PushUndo -> {
            .undo_stack.push(.px.join("|"))
            if .undo_stack.len() > 20 {
                var kept = []
                var k int = 1
                while k < .undo_stack.len() {
                    kept.push(.undo_stack[k])
                    k = k + 1
                }
                .undo_stack = kept
            }
            .redo_stack = []
            .saved = "0"
        }

        // ---- 泛洪（迭代 BFS 只算 seen 标记——变更集即 seen；随后单趟
        // 重建整体赋值。队列 int 列表 + qi 游标，禁递归；邻接用
        // h%16 / h>=16 / h<240 边界式绕开整数除法）----
        .Fill(i) -> {
            var target = .px[i]
            if target != .cur {
                .PushUndo()
                var queue = []
                queue.push(i)
                var seen = []
                var k int = 0
                while k < 256 {
                    seen.push(0)
                    k = k + 1
                }
                seen[i] = 1
                var qi int = 0
                while qi < queue.len() {
                    var h int = queue[qi]
                    qi = qi + 1
                    if h >= 16 {
                        var up int = h - 16
                        if seen[up] == 0 {
                            if .px[up] == target {
                                seen[up] = 1
                                queue.push(up)
                            }
                        }
                    }
                    if h < 240 {
                        var dn int = h + 16
                        if seen[dn] == 0 {
                            if .px[dn] == target {
                                seen[dn] = 1
                                queue.push(dn)
                            }
                        }
                    }
                    if h % 16 != 0 {
                        var lf int = h - 1
                        if seen[lf] == 0 {
                            if .px[lf] == target {
                                seen[lf] = 1
                                queue.push(lf)
                            }
                        }
                    }
                    if h % 16 != 15 {
                        var rt int = h + 1
                        if seen[rt] == 0 {
                            if .px[rt] == target {
                                seen[rt] = 1
                                queue.push(rt)
                            }
                        }
                    }
                }
                // 单趟重建：seen 位 → cur，否则原色
                var np = []
                var k2 int = 0
                while k2 < 256 {
                    if seen[k2] == 1 {
                        np.push(.cur)
                    } else {
                        np.push(.px[k2])
                    }
                    k2 = k2 + 1
                }
                .px = np
                .RebuildCells()
            }
        }

        // ---- 撤销/重做（快照互倒；栈丢底重建）----
        .Undo -> {
            if .undo_stack.len() > 0 {
                .redo_stack.push(.px.join("|"))
                var last int = .undo_stack.len() - 1
                var snap = .undo_stack[last]
                var kept = []
                var k int = 0
                while k < last {
                    kept.push(.undo_stack[k])
                    k = k + 1
                }
                .undo_stack = kept
                .ApplySnap(snap)
                .saved = "0"
            } else {
                .status = "nothing to undo"
            }
        }

        .Redo -> {
            if .redo_stack.len() > 0 {
                var last2 int = .redo_stack.len() - 1
                var snap2 = .redo_stack[last2]
                var kept2 = []
                var k2 int = 0
                while k2 < last2 {
                    kept2.push(.redo_stack[k2])
                    k2 = k2 + 1
                }
                var cur_snap = .px.join("|")
                .redo_stack = kept2
                .ApplySnap(snap2)
                .undo_stack.push(cur_snap)
                .saved = "0"
            } else {
                .status = "nothing to redo"
            }
        }

        // ---- 快照应用（hex 快照逐项校验 → 本地构建 → 整体赋值）。任一项
        // 非词汇表色或长度非 256 → 整体拒绝（不部分应用，当前画布不动）。----
        .ApplySnap(s) -> {
            var parts = s.split("|")
            if parts.len() == 256 {
                var ok int = 1
                var k int = 0
                while k < 256 {
                    if chip_of(parts[k]) == "" {
                        ok = 0
                    }
                    k = k + 1
                }
                if ok == 1 {
                    var np = []
                    var k2 int = 0
                    while k2 < 256 {
                        np.push(parts[k2])
                        k2 = k2 + 1
                    }
                    .px = np
                    .RebuildCells()
                }
            }
        }

        // ---- 清空（可撤销）/ 新建（清历史）----
        .Clear -> {
            var dirty int = 0
            var k int = 0
            while k < 256 {
                if .px[k] != .white {
                    dirty = 1
                }
                k = k + 1
            }
            if dirty == 1 {
                .PushUndo()
                var np = []
                var k2 int = 0
                while k2 < 256 {
                    np.push(.white)
                    k2 = k2 + 1
                }
                .px = np
                .RebuildCells()
                .status = ""
            }
        }

        .New -> {
            var np = []
            var k int = 0
            while k < 256 {
                np.push(.white)
                k = k + 1
            }
            .px = np
            .undo_stack = []
            .redo_stack = []
            .saved = "0"
            .RebuildCells()
            .status = "new canvas"
        }

        // ---- 工程存取。Save：v2 = "PAINT-V2|16|16|<hex×256>"，写入后回读
        // 比对一致才置 saved。Load：优先 v2（版本/尺寸/逐项色值全验）；无
        // v2 时只读迁移 v1（类串 → hex，非 256 项/非词汇表色拒绝）；坏数据
        // 一律不改当前画布。----
        .Save -> {
            var v2 = "PAINT-V2|16|16|" + .px.join("|")
            storage.set("paint.project.v2", v2)
            if storage.get("paint.project.v2") == v2 {
                .saved = "1"
                .status = "saved"
            } else {
                .saved = "0"
                .status = "save failed"
            }
        }

        .Load -> {
            var handled int = 0
            var v2 = storage.get("paint.project.v2")
            if v2 != "" {
                var parts = v2.split("|")
                if parts.len() == 259 {
                    if parts[0] == "PAINT-V2" {
                        if parts[1] == "16" {
                            if parts[2] == "16" {
                                var ok int = 1
                                var np = []
                                var k int = 3
                                while k < 259 {
                                    if chip_of(parts[k]) == "" {
                                        ok = 0
                                    }
                                    np.push(parts[k])
                                    k = k + 1
                                }
                                if ok == 1 {
                                    .PushUndo()
                                    .px = np
                                    .RebuildCells()
                                    .saved = "1"
                                    .status = "loaded"
                                } else {
                                    .status = "bad save data"
                                }
                                handled = 1
                            }
                        }
                    }
                }
                if handled == 0 {
                    .status = "bad save data"
                    handled = 1
                }
            }
            if handled == 0 {
                var v1 = storage.get("paint.canvas.v1")
                if v1 != "" {
                    var parts1 = v1.split("|")
                    if parts1.len() == 256 {
                        var ok1 int = 1
                        var np1 = []
                        var k2 int = 0
                        while k2 < 256 {
                            var hex = hex_of_v1(parts1[k2])
                            if hex == "" {
                                ok1 = 0
                            }
                            np1.push(hex)
                            k2 = k2 + 1
                        }
                        if ok1 == 1 {
                            .PushUndo()
                            .px = np1
                            .RebuildCells()
                            .saved = "1"
                            .status = "loaded v1"
                        } else {
                            .status = "bad save data"
                        }
                    } else {
                        .status = "bad save data"
                    }
                } else {
                    .status = "no saved canvas"
                }
            }
        }
    }
}

// hex 真值 → Tailwind 展示类（词汇表闭合映射，字面类串留在源码供 JIT 扫描）。
// 非词汇表色返回 ""（= 非法，写路径一律拒绝）。
fn chip_of(c str) str {
    if c == "#111827" { return " bg-[#111827] " }
    if c == "#ef4444" { return " bg-[#ef4444] " }
    if c == "#f97316" { return " bg-[#f97316] " }
    if c == "#f59e0b" { return " bg-[#f59e0b] " }
    if c == "#84cc16" { return " bg-[#84cc16] " }
    if c == "#22c55e" { return " bg-[#22c55e] " }
    if c == "#14b8a6" { return " bg-[#14b8a6] " }
    if c == "#3b82f6" { return " bg-[#3b82f6] " }
    if c == "#6366f1" { return " bg-[#6366f1] " }
    if c == "#a855f7" { return " bg-[#a855f7] " }
    if c == "#ec4899" { return " bg-[#ec4899] " }
    if c == "#92400e" { return " bg-[#92400e] " }
    if c == "#57534e" { return " bg-[#57534e] " }
    if c == "#a8a29e" { return " bg-[#a8a29e] " }
    if c == "#e7e5e4" { return " bg-[#e7e5e4] " }
    if c == "#ffffff" { return " bg-[#ffffff] " }
    return ""
}

// 旧 v1 类串（" bg-[#rrggbb] "）→ hex 真值；非词汇表/形不符返回 ""。
// 注意 split 会消费分隔符：split("bg-[#") 后段 = "rrggbb] "（无 #），
// hex 需补 "#" 前缀（T-02 实测：不补则恒 bad save data）。
fn hex_of_v1(s str) str {
    var halves = s.split("bg-[#")
    if halves.len() != 2 {
        return ""
    }
    var tails = halves[1].split("]")
    if tails.len() != 2 {
        return ""
    }
    var hex = "#" + tails[0]
    if tails[1] != " " {
        return ""
    }
    if halves[0] != " " {
        return ""
    }
    if chip_of(hex) == "" {
        return ""
    }
    return hex
}
